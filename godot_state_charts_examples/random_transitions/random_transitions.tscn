[sub_resource type="Shader" id="Shader_8j6vc"]
code = "shader_type canvas_item;

void fragment() {
	COLOR.rgb *= (1.0-0.3*(1.0-UV.y));
}

void vertex() {
	VERTEX.x -= UV.y * (0.5 - UV.x) * 100.0;
}
"

