; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="huge breakthrough project"
config/description="Dean, Erin, MINK"
config/version="1.0.0"
run/main_scene="res://scenes/opening/opening.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://bp7t2exveuhmj"

[audio]

buses/default_bus_layout="uid://c0f5bom4jj8gi"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
DebugMenu="*uid://cggqb75a8w8r"
ProjectUISoundController="*uid://cc37235kj4384"
SceneLoader="*uid://cpehcs7n5c62p"
ProjectMusicController="*uid://r5t485lr3p7t"
PhantomCameraManager="*uid://duq6jhf6unyis"
SoundManager="*uid://6q1wagejt60k"

[clean_copy_examples]

examples_paths=Array[String](["res://addons/maaacks_game_template/examples/", "res://addons/maaacks_scene_loader/examples/"])
replace_strings=Dictionary[String, String]({
"StateExample": "State"
})
copy_path="res://"

[debug]

gdscript/warnings/directory_rules={
"res://addons": 0,
"res://scripts/ARCHIVE SCRIPTS": 0
}

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

script/templates_search_path="res://scripts/templates"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/debug_menu/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/health_hitbox_hurtbox/plugin.cfg", "res://addons/maaacks_game_template/plugin.cfg", "res://addons/maaacks_music_controller/plugin.cfg", "res://addons/maaacks_scene_loader/plugin.cfg", "res://addons/maaacks_ui_sound_controller/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/plugin_updater/plugin.cfg", "res://addons/project-time-tracker/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/sound_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://godot_state_charts_examples/": "gray",
"res://scripts/ARCHIVE SCRIPTS/": "gray"
}

[gui]

theme/custom="res://resources/themes/lore.tres"

